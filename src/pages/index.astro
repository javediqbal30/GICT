---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CourseCard from '../components/CourseCard.astro';
import FacultyCard from '../components/FacultyCard.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import CTASection from '../components/CTASection.astro';
import BlogGrid from '../components/blog/BlogGrid.astro';
import HeroInteractiveBackground from '../components/HeroInteractiveBackground.astro';
import HeroSlider from '../components/HeroSlider.astro';
import { courses } from '../data/courses';
import { faculty } from '../data/faculty';
import { calculators } from '../data/calculators';
import { getRecentArticles } from '../lib/blog/service';

const featuredCalculators = calculators.filter((calculator) => calculator.featured);
const recentArticles = getRecentArticles(3);
---

<BaseLayout
  title="GICT Rawalpindi | Tax, Corporate & Finance Courses"
  description="Practitioner-led taxation, FBR IRIS, sales tax, corporate law and finance training in Rawalpindi. Weekend on-campus and live online cohorts."
>
  <section class="hero">
    <HeroInteractiveBackground />
    <div class="hero-decor" aria-hidden="true">
      <span class="hero-orb hero-orb--blue"></span>
      <span class="hero-orb hero-orb--gold"></span>
      <span class="hero-orb hero-orb--sky"></span>
    </div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Practical training.<br /><span class="hero-gradient">Tax, corporate law &amp; finance.</span></h1>
        <p class="hero-lede">
          Learn directly from practising advocates, chartered accountants and tax specialists. Work through
          live FBR IRIS filings, corporate tax computations, sales tax and litigation strategy &mdash; not just slides.
        </p>
        <ul class="hero-checklist">
          <li><span class="hero-check"><Icon name="check" size={12} /></span> Practitioner-led faculty</li>
          <li><span class="hero-check"><Icon name="check" size={12} /></span> Weekend &amp; live online</li>
          <li><span class="hero-check"><Icon name="check" size={12} /></span> Live IRIS and case work</li>
        </ul>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/courses">
            Explore programmes
            <Icon name="arrow-right" size={17} />
          </a>
          <button type="button" class="btn btn-outline" data-open-admission>
            Book a consultation
            <Icon name="message-circle" size={17} />
          </button>
        </div>
      </div>
      <div class="hero-media">
        <HeroSlider />
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Why students choose GICT">
    <div class="container trust-grid">
      <div class="trust-item">
        <span class="trust-icon"><Icon name="users" size={19} /></span>
        <div><strong>Practitioner faculty</strong><span>Advocates, CAs and tax specialists</span></div>
      </div>
      <div class="trust-item">
        <span class="trust-icon"><Icon name="file-check" size={19} /></span>
        <div><strong>Live portal work</strong><span>IRIS, returns and working papers</span></div>
      </div>
      <div class="trust-item">
        <span class="trust-icon"><Icon name="calendar" size={19} /></span>
        <div><strong>Weekend schedule</strong><span>Built for working professionals</span></div>
      </div>
      <div class="trust-item">
        <span class="trust-icon"><Icon name="map-pin" size={19} /></span>
        <div><strong>Rawalpindi campus</strong><span>Committee Chowk, Murree Road</span></div>
      </div>
    </div>
  </section>

  <section class="section section--white section--programmes" id="programmes">
    <div class="container">
      <SectionHeading
        eyebrow="Programmes"
        title="Choose a programme built around practice."
        description="Six focused tracks across taxation, law, finance and accounting software. Every programme combines current law with exercises you can use at work."
        align="center"
      />
      <div class="course-grid">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
      <div class="programmes-footer-cta">
        <a class="btn btn-outline" href="/courses">
          View all 6 programmes &amp; syllabus
          <Icon name="arrow-right" size={17} />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--soft section--why" id="why-gict">
    <div class="container">
      <SectionHeading
        eyebrow="Why GICT"
        title="A practical method, not a certificate mill."
        description="The classroom is built around the work: reading the law, preparing the computation, documenting the file and defending the position."
        align="center"
      />
      <div class="feature-grid">
        <article class="feature-card">
          <span class="feature-icon"><Icon name="file-check" size={22} /></span>
          <h3>Portal-first learning</h3>
          <p>Work inside the screens and forms practitioners use, from IRIS filings to sales tax returns and reconciliations.</p>
        </article>
        <article class="feature-card">
          <span class="feature-icon"><Icon name="scale" size={22} /></span>
          <h3>Law connected to practice</h3>
          <p>Each topic links the statutory provision to the working paper, the notice and the argument you may need to make.</p>
        </article>
        <article class="feature-card">
          <span class="feature-icon"><Icon name="users" size={22} /></span>
          <h3>Small, focused cohorts</h3>
          <p>Ask questions, review your work and get feedback from faculty who handle these issues in practice.</p>
        </article>
        <article class="feature-card">
          <span class="feature-icon"><Icon name="target" size={22} /></span>
          <h3>Outcome-led curriculum</h3>
          <p>Every module ends with a task you should be able to complete, not just a topic you have heard about.</p>
        </article>
      </div>
      <div class="stat-band">
        <div class="stat"><strong>6</strong><span>Practitioner-led programmes</span></div>
        <div class="stat"><strong>3</strong><span>Specialist faculty profiles</span></div>
        <div class="stat"><strong>2</strong><span>On-campus and online modes</span></div>
        <div class="stat"><strong>1</strong><span>Rawalpindi campus</span></div>
      </div>
    </div>
  </section>

  <section class="section section--white section--faculty" id="faculty">
    <div class="container">
      <SectionHeading
        eyebrow="Faculty"
        title="Learn from people who do the work."
        description="Our faculty combine practice with teaching. Profiles are published with consent and credentials are verified before publication."
        align="center"
      />
      <div class="faculty-grid">
        {faculty.map((member) => <FacultyCard member={member} />)}
      </div>
      <div class="faculty-footer-cta">
        <a class="btn btn-outline" href="/faculty">
          Meet the faculty &amp; practitioner mentors
          <Icon name="arrow-right" size={17} />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--navy section--calculators" id="tools">
    <div class="container">
      <SectionHeading
        eyebrow="Free tools"
        title="Run the numbers before the meeting."
        description="Practical calculators for salary tax, property advance tax, sales tax and more. Every tool shows its assumptions and runs entirely in your browser."
        align="center"
      />
      <div class="calculator-grid">
        {featuredCalculators.map((calculator) => <CalculatorCard calculator={calculator} />)}
      </div>
      <div class="calculators-footer-cta">
        <a class="btn btn-gold" href="/calculators">
          Explore all calculators &amp; tax tools
          <Icon name="arrow-right" size={17} />
        </a>
      </div>
      <p class="section-disclaimer">
        Estimates only. Confirm the current tax year and rates with FBR or a qualified adviser.
      </p>
    </div>
  </section>

  <section class="section section--soft section--blog" id="blog">
    <div class="container">
      <SectionHeading
        eyebrow="GICT Blog & Insights"
        title="Clear explanations for current taxation & legal problems."
        description="Practitioner notes on salary tax, FBR IRIS, sales tax and dispute response — written by senior faculty and advocates for professionals who need to act."
        align="center"
      />
      <!-- Exactly 1 row with 3 columns on desktop -->
      <BlogGrid articles={recentArticles} basePath="/blog" />
      <div class="blog-footer-cta">
        <a class="btn btn-outline" href="/blog">
          Explore all blog guides &amp; articles
          <Icon name="arrow-right" size={17} />
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Ready to build the practical skill?"
    text="Tell us where you are in your career and what you need to be able to do. Admissions will help you choose the right programme and schedule."
    primary={{ label: 'Apply for admission', href: '/contact' }}
    secondary={{ label: 'Browse calculators', href: '/calculators' }}
  />
</BaseLayout>
