---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import Icon from '../../components/Icon.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import { calculators, calculatorCategories } from '../../data/calculators';

const faqs = [
  {
    question: 'Are the calculators free?',
    answer: 'Yes. The calculators are free to use and run in your browser. We do not store the figures you enter.',
  },
  {
    question: 'Which tax year do the calculators use?',
    answer:
      'Each calculator shows its tax year or rate basis. Where rates change, confirm the current Finance Act and the applicable tax year before filing.',
  },
  {
    question: 'Are the results final tax liabilities?',
    answer:
      'No. They are estimates based on the inputs and assumptions shown. They do not account for every exemption, credit, surcharge or fact pattern.',
  },
  {
    question: 'Can I use these for a client file?',
    answer:
      'Use them as a checking tool, not as a substitute for the statute, the return or professional review. Keep the assumptions with your working paper.',
  },
  {
    question: 'Why do some tools ask me to enter a rate?',
    answer:
      'Rates can change and may depend on your registration, entity, province or transaction. Entering the applicable rate makes the assumption explicit rather than hiding it in the tool.',
  },
];
---
<BaseLayout
  title="Free Pakistan Tax & Finance Calculators | GICT"
  description="Use free Pakistan tax and finance calculators for salary, property, sales tax, corporate tax, gratuity, loans and NPV. Estimates only."
>
  <PageHero
    align="center"
    withOrbs={true}
    tone="sky"
    description="Free browser-based tools for salary tax, property advance tax, provincial sales tax, corporate tax, gratuity, and loan schedules. 100% private with visible statutory assumptions."
  >
    <div slot="breadcrumbs">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Calculators' }]} />
      <div class="about-eyebrow-pill">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>Free Pakistan Tax &amp; Finance Engine · GICT Rawalpindi</span>
      </div>
    </div>

    <h1 slot="title" class="about-hero-title">
      Run the practical numbers<br />
      <span class="hero-gradient">before the meeting or filing.</span>
    </h1>

    <div class="about-hero-actions">
      <a class="btn btn-primary" href="#calculators-grid">
        Explore all 8 calculators
        <Icon name="arrow-right" size={17} />
      </a>
      <a class="btn btn-outline" href="/courses">
        Learn the filing method
        <Icon name="graduation-cap" size={17} />
      </a>
      <a
        class="btn btn-whatsapp"
        href="https://wa.me/923390006854?text=Hello%20GICT%2C%20I%20have%20a%20tax%20calculation%20question."
        target="_blank"
        rel="noopener"
      >
        <Icon name="whatsapp" size={17} />
        <span>Ask on WhatsApp</span>
      </a>
    </div>

    <!-- Interactive 4-Item Calculators Capability Strip -->
    <div class="about-hero-badges" aria-label="GICT Calculator Standards">
      <div class="hero-badge-item">
        <span class="badge-icon"><Icon name="calculator" size={20} /></span>
        <div class="badge-text">
          <strong>Salary Tax Slabs</strong>
          <span>Finance Act Progressive Rates &amp; Withholding</span>
        </div>
      </div>
      <div class="hero-badge-item">
        <span class="badge-icon"><Icon name="home" size={20} /></span>
        <div class="badge-text">
          <strong>Property Advance Tax</strong>
          <span>Section 236C &amp; 236K Filer/Non-Filer Rates</span>
        </div>
      </div>
      <div class="hero-badge-item">
        <span class="badge-icon"><Icon name="receipt" size={20} /></span>
        <div class="badge-text">
          <strong>Sales Tax on Services</strong>
          <span>PRA, SRB &amp; FBR Input-Output Tax Working</span>
        </div>
      </div>
      <div class="hero-badge-item">
        <span class="badge-icon"><Icon name="shield" size={20} /></span>
        <div class="badge-text">
          <strong>100% Browser Privacy</strong>
          <span>Zero Server Storage · Instant Client Computation</span>
        </div>
      </div>
    </div>
  </PageHero>

  <section class="section section--white" id="calculators-grid">
    <div class="container">
      <div class="filter-bar">
        <div class="filter-chips" role="group" aria-label="Filter calculators by category">
          {calculatorCategories.map((category) => (
            <button
              type="button"
              class="chip"
              data-calculator-filter={category}
              aria-pressed={category === 'All' ? 'true' : 'false'}
            >
              {category}
            </button>
          ))}
        </div>
        <label class="search-field">
          <Icon name="search" size={17} />
          <span class="sr-only">Search calculators</span>
          <input type="search" placeholder="Search calculators" data-calculator-search />
        </label>
      </div>

      <div class="filter-bar" style="margin-top:-8px;">
        <p class="filter-count" data-calculator-count>{calculators.length} calculators</p>
      </div>

      <div class="calculator-hub-grid" data-calculator-grid>
        {calculators.map((calculator) => <CalculatorCard calculator={calculator} />)}
      </div>

      <div class="empty-state" data-calculator-empty hidden>
        <h3>No calculator matches that search.</h3>
        <p>Try a broader term, or clear the filters to see all tools.</p>
      </div>

      <div class="disclaimer-box" style="margin-top:30px;">
        <Icon name="info" size={18} />
        <p>
          These calculators provide estimates for general information. They are not tax, legal or financial
          advice, and they do not create an adviser-client relationship. Verify the current law and your
          specific facts before filing or making a decision.
        </p>
      </div>
    </div>
  </section>

  <FAQ
    eyebrow="Using the tools"
    title="What the numbers can and cannot tell you."
    description="A calculator is a checking tool. The statute, the facts and the working paper still matter."
    items={faqs}
  />

  <CTASection
    title="Want to understand the calculation behind the tool?"
    text="Our programmes cover the law, the computation and the filing workflow in practice."
    primary={{ label: 'Explore programmes', href: '/courses' }}
    secondary={{ label: 'Read the Knowledge Hub', href: '/knowledge-hub' }}
  />
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-calculator-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-calculator-grid] .calculator-card');
  const search = document.querySelector<HTMLInputElement>('[data-calculator-search]');
  const count = document.querySelector<HTMLElement>('[data-calculator-count]');
  const empty = document.querySelector<HTMLElement>('[data-calculator-empty]');
  let activeCategory = 'All';

  const applyFilters = () => {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const categoryMatch = activeCategory === 'All' || card.dataset.category === activeCategory;
      const searchMatch = !query || (card.dataset.search ?? '').includes(query);
      const match = categoryMatch && searchMatch;
      card.hidden = !match;
      if (match) visible += 1;
    });

    if (count) count.textContent = `${visible} ${visible === 1 ? 'calculator' : 'calculators'}`;
    if (empty) empty.hidden = visible !== 0;
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeCategory = button.dataset.calculatorFilter ?? 'All';
      filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      applyFilters();
    });
  });

  search?.addEventListener('input', applyFilters);
</script>
