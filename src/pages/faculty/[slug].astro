---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CTASection from '../../components/CTASection.astro';
import { faculty, type FacultyMember } from '../../data/faculty';
import { getCourse } from '../../data/courses';
import { site } from '../../data/site';

export function getStaticPaths() {
  return faculty.map((member) => ({ params: { slug: member.slug }, props: { member } }));
}

interface Props {
  member: FacultyMember;
}

const { member } = Astro.props;
const displayName = member.prefix ? `${member.prefix} ${member.name}` : member.name;
const taughtCourses = member.courses.map((slug) => getCourse(slug)).filter(Boolean);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: displayName,
  jobTitle: member.designation,
  worksFor: { '@type': 'EducationalOrganization', name: site.legalName, url: site.url },
  knowsAbout: member.focus,
  ...(member.image ? { image: new URL(member.image, site.url).toString() } : {}),
};
---
<BaseLayout title={member.metaTitle} description={member.metaDescription} jsonLd={personSchema}>
  <PageHero
    align="center"
    withOrbs={true}
    tone="sky"
    description={member.bio}
  >
    <div slot="breadcrumbs">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Faculty', href: '/faculty' },
          { label: member.name },
        ]}
      />
      <div class="about-eyebrow-pill">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>Senior Faculty Profile · GICT Rawalpindi</span>
      </div>
    </div>

    <h1 slot="title" class="about-hero-title">
      {displayName}
      <span class="hero-gradient" style="display:block;font-size:clamp(18px,2.2vw,24px);font-weight:600;margin-top:8px;">
        {member.designation}
      </span>
    </h1>

    <div class="about-hero-actions">
      <a class="btn btn-primary" href="#profile-details">
        View profile &amp; courses
        <Icon name="arrow-right" size={17} />
      </a>
      <a
        class="btn btn-whatsapp"
        href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hello GICT, I want to learn more about classes taught by ${displayName}.`)}`}
        target="_blank"
        rel="noopener"
      >
        <Icon name="whatsapp" size={18} />
        Consult on WhatsApp
      </a>
      <a class="btn btn-outline" href="/faculty">
        <span>All faculty</span>
        <Icon name="chevron-right" size={16} />
      </a>
    </div>

    <div class="about-hero-badges">
      <div class="hero-badge-item">
        <span class="badge-icon"><Icon name="award" size={20} /></span>
        <div class="badge-text">
          <strong>Primary Credential</strong>
          <span>{member.qualifications[0]}</span>
        </div>
      </div>
      <div class="hero-badge-item">
        <span class="badge-icon"><Icon name="graduation-cap" size={20} /></span>
        <div class="badge-text">
          <strong>{taughtCourses.length} Active Programmes</strong>
          <span>Weekend &amp; online cohorts</span>
        </div>
      </div>
      <div class="hero-badge-item">
        <span class="badge-icon"><Icon name="file-check" size={20} /></span>
        <div class="badge-text">
          <strong>Practitioner Training</strong>
          <span>Hands-on case studies &amp; filing</span>
        </div>
      </div>
      <div class="hero-badge-item">
        <span class="badge-icon"><Icon name="map-pin" size={20} /></span>
        <div class="badge-text">
          <strong>Rawalpindi Campus</strong>
          <span>Committee Chowk, Murree Road</span>
        </div>
      </div>
    </div>
  </PageHero>

  <section class="section section--white" id="profile-details">
    <div class="container profile-layout">
      <aside class="profile-aside">
        <div class="profile-photo">
          {member.image ? (
            <img src={member.image} alt={displayName} width="480" height="600" loading="eager" />
          ) : (
            <span class="faculty-placeholder">
              <span>{member.initials}</span>
              <small>GICT Faculty</small>
            </span>
          )}
        </div>
        <div class="profile-card">
          <h2>Areas of focus</h2>
          <ul>
            {member.focus.map((item) => <li><Icon name="check" size={14} /> {item}</li>)}
          </ul>
        </div>
        <div class="profile-card">
          <h2>Qualifications</h2>
          <ul>
            {member.qualifications.map((item) => <li><Icon name="award" size={14} /> {item}</li>)}
          </ul>
        </div>
      </aside>

      <div>
        <div class="profile-intro">
          <p class="profile-role">{member.designation}</p>
          <p class="profile-bio">{member.bio}</p>
          <div class="profile-focus">
            {member.focus.map((item) => <span>{item}</span>)}
          </div>
        </div>

        <div class="profile-section">
          <h2>Teaches on</h2>
          <div class="profile-course-list">
            {taughtCourses.map((course) => course && (
              <a href={`/courses/${course.slug}`}>
                <span>{course.title} · {course.duration}</span>
                <Icon name="arrow-right" size={16} />
              </a>
            ))}
          </div>
        </div>

        <div class="profile-section">
          <h2>Teaching approach</h2>
          <p>
            Sessions are built around working documents: the return, the computation, the notice, the
            grounds of appeal or the client file. The aim is to leave with a repeatable method, not a
            memorised summary.
          </p>
        </div>

        <div class="profile-section">
          <h2>Profile verification</h2>
          <p>
            This profile is published with consent. Credentials are checked before publication. Contact
            admissions if you need the faculty member's availability for a specific cohort or corporate
            programme.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Study with practitioners."
    text="Explore the programmes taught by GICT faculty and choose the track that matches your work."
    primary={{ label: 'View programmes', href: '/courses' }}
    secondary={{ label: 'Meet the faculty', href: '/faculty' }}
  />
</BaseLayout>
