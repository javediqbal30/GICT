---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import { courses, type Course } from '../../data/courses';
import { getFaculty } from '../../data/faculty';
import { site } from '../../data/site';

export function getStaticPaths() {
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

interface Props {
  course: Course;
}

const { course } = Astro.props;
const courseFaculty = course.facultySlugs.map((slug) => getFaculty(slug)).filter(Boolean);
const related = courses.filter((item) => item.slug !== course.slug && item.category === course.category).slice(0, 2);
const fallbackRelated = courses.filter((item) => item.slug !== course.slug).slice(0, 2);
const relatedCourses = related.length ? related : fallbackRelated;
const closed = course.status === 'Coming soon';

const faqs = [
  { question: 'Who is this programme for?', answer: course.audience.join(', ') + '.' },
  { question: 'What background do I need?', answer: course.prerequisites },
  { question: 'How is the programme assessed?', answer: course.assessment },
  { question: 'What certificate will I receive?', answer: course.certificate },
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.title,
  description: course.description,
  provider: {
    '@type': 'EducationalOrganization',
    name: site.legalName,
    sameAs: site.url,
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: ['onsite', 'online'],
    courseWorkload: course.duration.replace(' weeks', 'W').replace(' ', ''),
  },
};
---
<BaseLayout
  title={course.metaTitle}
  description={course.metaDescription}
  jsonLd={courseSchema}
>
  <section class="course-hero">
    <div class="course-hero-decor" aria-hidden="true">
      <span class="hero-orb hero-orb--blue"></span>
      <span class="hero-orb hero-orb--gold"></span>
    </div>
    <div class="page-hero-pattern" aria-hidden="true"></div>
    <div class="container course-hero-grid">
      <div class="course-hero-copy">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Courses', href: '/courses' },
            { label: course.title },
          ]}
        />
        <div class="course-eyebrow-row">
          <span class="badge badge--gold">{course.category} Track</span>
          <span class:list={['status', 'status--pill', { 'status--soon': closed }]}>
            <span class="status-dot"></span>
            {course.status}
          </span>
        </div>
        <h1 class="course-hero-title">{course.title}</h1>
        <p class="course-hero-summary">{course.summary}</p>

        <div class="course-detail-meta">
          <div class="meta-pill"><Icon name="clock" size={15} /> <span>{course.duration}</span></div>
          <div class="meta-pill"><Icon name="monitor" size={15} /> <span>{course.format}</span></div>
          <div class="meta-pill"><Icon name="graduation-cap" size={15} /> <span>{course.level}</span></div>
          <div class="meta-pill"><Icon name="shield" size={15} /> <span>Verified Certificate</span></div>
        </div>

        <div class="course-hero-actions">
          {closed ? (
            <a class="btn btn-gold" href="/contact">
              Register interest for next cohort
              <Icon name="arrow-right" size={16} />
            </a>
          ) : (
            <button type="button" class="btn btn-gold" data-open-admission data-programme={course.slug}>
              Apply for this cohort
              <Icon name="arrow-right" size={16} />
            </button>
          )}
          <a
            class="btn btn-whatsapp"
            href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hello GICT, I would like admission details about ${course.title}.`)}`}
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" size={17} />
            <span>Ask on WhatsApp</span>
          </a>
          <a class="btn btn-outline" href="#curriculum">
            <span>View curriculum</span>
            <Icon name="chevron-down" size={15} />
          </a>
        </div>
      </div>

      <div class="course-hero-visual">
        <div class="course-visual-card">
          <img
            src={course.image}
            alt={course.title}
            loading="eager"
            decoding="async"
            class="course-visual-img"
          />
          <div class="course-visual-caption">
            <span class="visual-tag"><Icon name="file-check" size={14} /> Practitioner Instruction</span>
            <p>Live FBR IRIS &amp; Working File Practice</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container course-layout">
      <div class="course-content">
        <div class="content-section">
          <h2>Programme overview</h2>
          <p>{course.description}</p>
          <div class="fact-grid">
            <div class="fact-card"><span>Duration</span><strong>{course.duration}</strong></div>
            <div class="fact-card"><span>Format</span><strong>{course.format}</strong></div>
            <div class="fact-card"><span>Level</span><strong>{course.level}</strong></div>
          </div>
        </div>

        <div class="content-section">
          <h2>What you will be able to do</h2>
          <ul class="outcome-list">
            {course.outcomes.map((outcome) => (
              <li><Icon name="check" size={16} /> {outcome}</li>
            ))}
          </ul>
        </div>

        <div class="content-section" id="curriculum">
          <h2>Curriculum</h2>
          <p>Each module connects the law to a practical task. The sequence below is indicative and may be adjusted to the cohort and current law.</p>
          <div class="curriculum">
            {course.modules.map((module, index) => (
              <details open={index === 0}>
                <summary>Module {String(index + 1).padStart(2, '0')} — {module.title}</summary>
                <div class="curriculum-body">
                  <ul>
                    {module.topics.map((topic) => <li>{topic}</li>)}
                  </ul>
                </div>
              </details>
            ))}
          </div>
        </div>

        <div class="content-section">
          <h2>Assessment and certificate</h2>
          <p>{course.assessment}</p>
          <p>{course.certificate}</p>
        </div>

        <div class="content-section">
          <h2>Faculty</h2>
          <p>You will learn from practitioners who work with these provisions and processes.</p>
          <div class="faculty-mini-list">
            {courseFaculty.map((member) => member && (
              <div class="faculty-mini">
                {member.image ? (
                  <img src={member.image} alt="" width="48" height="48" loading="lazy" />
                ) : (
                  <span class="mini-placeholder">{member.initials}</span>
                )}
                <div>
                  <strong>{member.prefix} {member.name}</strong>
                  <span>{member.designation}</span>
                </div>
                <a href={`/faculty/${member.slug}`} aria-label={`View ${member.name}'s profile`}>
                  <Icon name="arrow-right" size={16} />
                </a>
              </div>
            ))}
          </div>
        </div>

        <div class="content-section">
          <h2>Who it is for</h2>
          <ul class="outcome-list">
            {course.audience.map((item) => <li><Icon name="users" size={16} /> {item}</li>)}
          </ul>
          <h3>Prerequisites</h3>
          <p>{course.prerequisites}</p>
        </div>

        <div class="content-section">
          <h2>Related programmes</h2>
          <div class="related-grid">
            {relatedCourses.map((item) => (
              <a class="related-course" href={`/courses/${item.slug}`}>
                <span>{item.category} · {item.duration}</span>
                <strong>{item.title}</strong>
              </a>
            ))}
          </div>
        </div>
      </div>

      <aside class="course-sidebar" aria-label="Enrolment information">
        <div class="enrol-card">
          <p class="eyebrow eyebrow--light">Next step</p>
          <h2>{closed ? 'Register your interest' : 'Join the next cohort'}</h2>
          <p>
            {closed
              ? 'This programme is being prepared. Register your interest and admissions will contact you when dates are confirmed.'
              : 'Speak to admissions about the schedule, fee and seat availability. We will confirm the next step before you commit.'}
          </p>
          <ul class="enrol-facts">
            <li><span>Duration</span><strong>{course.duration}</strong></li>
            <li><span>Format</span><strong>{course.format}</strong></li>
            <li><span>Level</span><strong>{course.level}</strong></li>
            <li><span>Status</span><strong>{course.status}</strong></li>
          </ul>
          {closed ? (
            <a class="btn btn-gold btn-block" href="/contact">
              Register interest
              <Icon name="arrow-right" size={16} />
            </a>
          ) : (
            <button type="button" class="btn btn-gold btn-block" data-open-admission data-programme={course.slug}>
              Apply for this programme
              <Icon name="arrow-right" size={16} />
            </button>
          )}
          <a class="btn btn-ghost-light btn-block" href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hello GICT, I would like details about ${course.title}.`)}`} target="_blank" rel="noopener">
            Ask on WhatsApp
            <Icon name="whatsapp" size={17} />
          </a>
          <p class="enrol-note">Fees and payment options are confirmed by admissions. See the refund policy before enrolling.</p>
        </div>
      </aside>
    </div>
  </section>

  <FAQ
    eyebrow="Course questions"
    title="Before you apply."
    description="A few answers about audience, background, assessment and certification."
    items={faqs}
  />

  <CTASection
    title="Want to compare this with another track?"
    text="Send a short enquiry with your background and the work you want to handle. We will help you choose."
    primary={{ label: 'Talk to admissions', href: '/contact' }}
    secondary={{ label: 'View all programmes', href: '/courses' }}
  />
</BaseLayout>
