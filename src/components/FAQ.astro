---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  items: FAQItem[];
  title?: string;
  eyebrow?: string;
  description?: string;
  schema?: boolean;
}

const { items, title = 'Questions, answered.', eyebrow = 'FAQ', description, schema = true } = Astro.props;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<section class="section section--white faq-section">
  <div class="container faq-layout">
    <div class="faq-intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      {description && <p>{description}</p>}
    </div>
    <div class="faq-list">
      {items.map((item) => (
        <details>
          <summary>
            <span>{item.question}</span>
            <span class="faq-icon" aria-hidden="true"><span></span><span></span></span>
          </summary>
          <div class="faq-answer"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</section>
