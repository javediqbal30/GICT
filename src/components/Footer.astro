---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { footerLinks } from '../data/navigation';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-gold-line" aria-hidden="true"></div>
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="GICT home">
        <Logo size={54} />
      </a>
      <p class="footer-tagline">
        Practitioner-led taxation, corporate law and finance training in Rawalpindi. On-campus and live online.
      </p>
      <div class="footer-contact">
        <a href={site.phoneHref}><Icon name="phone" size={17} /> {site.phoneDisplay}</a>
        <a href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} /> {site.whatsappDisplay}
        </a>
        <a href={`mailto:${site.email}`}><Icon name="mail" size={17} /> {site.email}</a>
        <a href={site.mapUrl} target="_blank" rel="noopener">
          <Icon name="map-pin" size={17} /> Committee Chowk, Rawalpindi
        </a>
      </div>
    </div>

    <div class="footer-column">
      <h2 class="footer-heading">Programmes</h2>
      <ul>
        {footerLinks.programmes.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-column">
      <h2 class="footer-heading">Explore</h2>
      <ul>
        {footerLinks.explore.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-column footer-visit">
      <h2 class="footer-heading">Visit the campus</h2>
      <p>{site.address.line1}<br />{site.address.line2}<br />{site.address.city}, Pakistan</p>
      <p class="footer-hours"><Icon name="clock" size={16} /> {site.hours}</p>
      <a class="footer-cta" href="/contact">
        Book a campus visit
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </div>

  <div class="container footer-locations-bar">
    <div class="locations-bar-inner">
      <span class="locations-bar-title"><Icon name="map-pin" size={14} /> Training Hubs:</span>
      <nav aria-label="Taxation Institute Locations" class="locations-nav">
        {footerLinks.locations.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.legalName}. All rights reserved.</p>
    <nav aria-label="Legal">
      {footerLinks.legal.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .footer-locations-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 16px;
  }

  .locations-bar-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 12.5px;
  }

  .locations-bar-title {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--gold, #d39100);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 11.5px;
  }

  .locations-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .locations-nav a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .locations-nav a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .locations-bar-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .locations-nav {
      gap: 10px 14px;
    }
  }
</style>
