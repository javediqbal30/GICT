---
import Icon from '../Icon.astro';
---
<div class="calc" data-calculator="corporate">
  <form class="calc-form" data-calc-form>
    <div class="calc-fields">
      <div class="calc-field">
        <label for="corp-profit">Taxable profit</label>
        <div class="input-wrap"><span class="input-prefix">PKR</span><input id="corp-profit" name="profit" type="number" min="0" step="10000" value="10000000" inputmode="decimal" /></div>
      </div>
      <div class="calc-field">
        <label for="corp-rate">Corporate tax rate</label>
        <div class="input-wrap"><input id="corp-rate" name="rate" type="number" min="0" max="100" step="0.01" value="29" inputmode="decimal" /><span class="input-suffix">%</span></div>
        <p class="field-hint">Use the rate that applies to your company and tax year.</p>
      </div>
      <div class="calc-field">
        <label for="corp-credits">Tax credits / already paid <span>Optional</span></label>
        <div class="input-wrap"><span class="input-prefix">PKR</span><input id="corp-credits" name="credits" type="number" min="0" step="1000" value="0" inputmode="decimal" /></div>
      </div>
    </div>
  </form>

  <div class="calc-result" aria-live="polite" aria-atomic="true">
    <div class="result-hero">
      <span class="result-label">Estimated corporate tax</span>
      <strong data-result="tax">PKR 0</strong>
      <span class="result-sub" data-result="effective">Effective rate 0%</span>
    </div>
    <div class="result-rows">
      <div><span>Tax before credits</span><strong data-result="gross">PKR 0</strong></div>
      <div><span>Credits applied</span><strong data-result="credits">PKR 0</strong></div>
      <div><span>After-tax profit</span><strong data-result="after">PKR 0</strong></div>
      <div><span>Net payable / (refundable)</span><strong data-result="net">PKR 0</strong></div>
    </div>
    <p class="result-note">Simplified estimate. It does not apply minimum tax, super tax, group relief or special regimes. Confirm the current corporate rate and adjustments with a tax adviser.</p>
    <button type="button" class="btn btn-outline btn-sm" data-calc-reset><Icon name="x" size={14} /> Reset</button>
  </div>
</div>

<script>
  import { money, inputNumber } from '../../lib/format';

  const root = document.querySelector<HTMLElement>('[data-calculator="corporate"]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-calc-form]')!;
    const result = (name: string) => root.querySelector<HTMLElement>(`[data-result="${name}"]`)!;

    const calculate = () => {
      const data = new FormData(form);
      const profit = Math.max(0, inputNumber(data, 'profit'));
      const rate = Math.min(100, Math.max(0, inputNumber(data, 'rate')));
      const credits = Math.max(0, inputNumber(data, 'credits'));
      const gross = (profit * rate) / 100;
      const net = gross - credits;
      const effective = profit > 0 ? (gross / profit) * 100 : 0;

      result('tax').textContent = money(gross);
      result('effective').textContent = `Effective rate ${effective.toFixed(2)}%`;
      result('gross').textContent = money(gross);
      result('credits').textContent = money(credits);
      result('after').textContent = money(profit - gross);
      result('net').textContent = money(net);
    };

    form.addEventListener('input', calculate);
    root.querySelector('[data-calc-reset]')?.addEventListener('click', () => {
      form.reset();
      calculate();
    });
    calculate();
  }
</script>
