---
import Icon from '../Icon.astro';
import type { BlogArticle } from '../../lib/blog/types';

export interface Props {
  article: BlogArticle;
}

const { article } = Astro.props;

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString('en-PK', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<div class="blog-byline-container">
  <div class="blog-byline-grid">
    <div class="byline-item">
      <span class="byline-label">Author</span>
      <span class="byline-value">
        <Icon name="users" size={14} />
        <strong>{article.author}</strong>
      </span>
    </div>

    <div class="byline-item byline-item--verified">
      <span class="byline-label">Legal & Tax Reviewer</span>
      <span class="byline-value">
        <Icon name="shield" size={14} class="reviewer-icon" />
        <strong>{article.reviewer}</strong>
        <span class="verified-pill">Verified</span>
      </span>
    </div>

    <div class="byline-item">
      <span class="byline-label">Last Updated</span>
      <span class="byline-value">
        <Icon name="calendar" size={14} />
        <time datetime={article.updated}>{formatDate(article.updated)}</time>
      </span>
    </div>

    <div class="byline-item">
      <span class="byline-label">Reading Duration</span>
      <span class="byline-value">
        <Icon name="clock" size={14} />
        <span>{article.readingTime}</span>
      </span>
    </div>
  </div>
</div>

<style>
  .blog-byline-container {
    margin-top: 28px;
    padding: 16px 24px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05), 0 4px 6px -2px rgba(15, 23, 42, 0.025);
    border-radius: 16px;
    display: inline-block;
    max-width: 100%;
  }

  .blog-byline-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .byline-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }

  .byline-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748b;
    font-weight: 700;
  }

  .byline-value {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    color: #0f172a;
    font-weight: 600;
  }

  .byline-value :global(svg) {
    color: #0284c7;
    flex-shrink: 0;
  }

  .byline-item--verified :global(.reviewer-icon) {
    color: #059669;
  }

  .verified-pill {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
    padding: 2px 8px;
    border-radius: 999px;
    margin-left: 6px;
    letter-spacing: 0.03em;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .blog-byline-container {
      padding: 14px 18px;
      width: 100%;
    }

    .blog-byline-grid {
      gap: 16px;
      justify-content: flex-start;
    }

    .byline-item {
      flex: 1 1 calc(50% - 16px);
      min-width: 140px;
    }
  }

  @media (max-width: 480px) {
    .byline-item {
      flex: 1 1 100%;
    }
  }
</style>
