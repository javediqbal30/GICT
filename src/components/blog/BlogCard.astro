---
import Icon from '../Icon.astro';
import type { BlogArticle } from '../../lib/blog/types';

export interface Props {
  article: BlogArticle;
  basePath?: string;
  featured?: boolean;
}

const { article, basePath = '/blog', featured = false } = Astro.props;

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString('en-PK', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });

const articleUrl = `${basePath}/${article.slug}`;
---

<article
  class:list={['blog-card', { 'blog-card--featured': featured }]}
  data-category={article.category}
  data-slug={article.slug}
>
  <!-- Card Cover Image Container -->
  <a href={articleUrl} class="blog-card-media" aria-label={`Read article: ${article.title}`}>
    <img
      src={article.coverImage.src}
      alt={article.coverImage.alt}
      loading="lazy"
      decoding="async"
      class="blog-card-img"
    />
    <span class="badge badge--category blog-media-badge">{article.category}</span>
  </a>

  <div class="blog-card-content">
    <div class="blog-card-header">
      <span class="blog-reading-time" title="Estimated reading time">
        <Icon name="clock" size={13} />
        <span>{article.readingTime}</span>
      </span>
      <time datetime={article.updated} class="blog-card-date">{formatDate(article.updated)}</time>
    </div>

    <h3 class="blog-card-title">
      <a href={articleUrl} class="blog-title-link">
        {article.title}
      </a>
    </h3>

    <p class="blog-card-excerpt">
      {article.excerpt}
    </p>

    <footer class="blog-card-footer">
      <div class="blog-card-byline">
        <span class="author-dot" aria-hidden="true"></span>
        <span class="author-name">{article.author}</span>
      </div>

      <a href={articleUrl} class="blog-read-cta" aria-label={`Read article: ${article.title}`}>
        <span>Read article</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </footer>
  </div>
</article>

<style>
  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white, #ffffff);
    border: 1px solid var(--line, #e2e8f0);
    border-radius: 18px;
    overflow: hidden;
    transition:
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 280ms cubic-bezier(0.16, 1, 0.3, 1),
      background 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3.5px;
    background: linear-gradient(90deg, #001f4e 0%, #0284c7 50%, #d39100 100%);
    opacity: 0;
    transform: scaleX(0.35);
    z-index: 2;
    transition: opacity 280ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-card:hover {
    transform: translateY(-6px);
    border-color: rgba(14, 165, 233, 0.45);
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    box-shadow:
      0 20px 40px -10px rgba(0, 31, 78, 0.12),
      0 6px 16px -4px rgba(14, 165, 233, 0.08);
  }

  .blog-card:hover::before {
    opacity: 1;
    transform: scaleX(1);
  }

  /* Media / Image Container */
  .blog-card-media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--soft, #f1f5f9);
    text-decoration: none;
  }

  .blog-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-card:hover .blog-card-img {
    transform: scale(1.05);
  }

  .blog-media-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: 0 4px 10px rgba(0, 31, 78, 0.18);
    backdrop-filter: blur(6px);
  }

  /* Content Wrapper */
  .blog-card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 24px 24px 22px 24px;
  }

  .blog-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .blog-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--muted, #64748b);
  }

  .blog-card-date {
    font-size: 11.5px;
    color: var(--muted, #94a3b8);
  }

  .blog-card-title {
    margin: 0 0 10px 0;
    font-size: 19px;
    line-height: 1.35;
    font-weight: 700;
    color: var(--ink, #0f172a);
  }

  .blog-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .blog-title-link:hover,
  .blog-card:hover .blog-title-link {
    color: var(--navy-3, #0284c7);
  }

  .blog-title-link:focus-visible {
    outline: 2px solid var(--gold, #d39100);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .blog-card-excerpt {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.62;
    color: var(--body, #334155);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--line, #e2e8f0);
    font-size: 11.5px;
    color: var(--muted, #64748b);
    transition: border-color 200ms ease;
  }

  .blog-card:hover .blog-card-footer {
    border-top-color: rgba(0, 31, 78, 0.12);
  }

  .blog-card-byline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .author-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--navy-3, #0284c7);
  }

  .author-name {
    font-weight: 500;
    color: var(--body, #475569);
  }

  .blog-read-cta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-weight: 600;
    color: var(--navy, #001f4e);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .blog-read-cta svg {
    transition: transform 200ms ease;
  }

  .blog-card:hover .blog-read-cta {
    color: var(--navy-3, #0284c7);
  }

  .blog-card:hover .blog-read-cta svg {
    transform: translateX(4px);
  }
</style>
