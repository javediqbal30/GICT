---
import Icon from './Icon.astro';
import type { Article } from '../data/articles';

export interface Props {
  article: Article;
}

const { article } = Astro.props;
const formatDate = (value: string) =>
  new Date(value).toLocaleDateString('en-PK', { day: 'numeric', month: 'short', year: 'numeric' });
---
<article class="article-card" data-category={article.category}>
  <span class="badge">{article.category}</span>
  <h3><a href={`/knowledge-hub/${article.slug}`}>{article.title}</a></h3>
  <p>{article.excerpt}</p>
  <div class="article-card-meta">
    <span>{formatDate(article.updated)} · {article.readingTime}</span>
    <a class="text-link" href={`/knowledge-hub/${article.slug}`}>
      Read
      <Icon name="arrow-right" size={14} />
    </a>
  </div>
</article>
