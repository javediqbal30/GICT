---
import Icon from './Icon.astro';
import type { Article } from '../data/articles';

export interface Props {
  article: Article;
  basePath?: string;
}

const { article, basePath = '/blog' } = Astro.props;
const formatDate = (value: string) =>
  new Date(value).toLocaleDateString('en-PK', { day: 'numeric', month: 'short', year: 'numeric' });
const articleUrl = `${basePath}/${article.slug}`;
---
<article class="article-card" data-category={article.category}>
  <div class="article-card-top">
    <span class="badge">{article.category}</span>
    <span class="article-read-badge"><Icon name="clock" size={13} /> {article.readingTime}</span>
  </div>
  <h3><a href={articleUrl}>{article.title}</a></h3>
  <p>{article.excerpt}</p>
  <div class="article-card-meta">
    <div class="article-author-meta">
      <span class="author-dot"></span>
      <span class="author-name">{article.author}</span>
      <span class="meta-sep">·</span>
      <time datetime={article.updated}>{formatDate(article.updated)}</time>
    </div>
    <a class="text-link" href={articleUrl} aria-label={`Read full article: ${article.title}`}>
      Read
      <Icon name="arrow-right" size={14} />
    </a>
  </div>
</article>
