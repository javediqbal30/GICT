---
import Icon from './Icon.astro';
import type { Course } from '../data/courses';

export interface Props {
  course: Course;
  compact?: boolean;
}

const { course, compact = false } = Astro.props;
const closed = course.status === 'Coming soon';
---
<article class:list={['course-card', { 'course-card--featured': course.featured, 'course-card--muted': closed, 'course-card--compact': compact }]} data-category={course.category}>
  <div class="course-card-top">
    <span class="badge">{course.category}</span>
    <span class:list={['status', { 'status--soon': closed }]}>
      <span class="status-dot"></span>
      {course.status}
    </span>
  </div>

  <div class="course-card-icon">
    <Icon name={course.icon} size={24} />
  </div>

  <h3><a href={`/courses/${course.slug}`}>{course.title}</a></h3>
  <p class="course-card-summary">{course.summary}</p>

  <ul class="course-meta">
    <li><Icon name="clock" size={15} /> {course.duration}</li>
    <li><Icon name="monitor" size={15} /> {course.format}</li>
    <li><Icon name="graduation-cap" size={15} /> {course.level}</li>
  </ul>

  <div class="course-card-footer">
    <a class="text-link" href={`/courses/${course.slug}`}>
      View programme
      <Icon name="arrow-right" size={16} />
    </a>
    {closed ? (
      <a class="text-link text-link--quiet" href="/contact">Register interest</a>
    ) : (
      <button type="button" class="text-link text-link--button" data-open-admission data-programme={course.slug}>
        Apply
        <Icon name="arrow-up-right" size={15} />
      </button>
    )}
  </div>
</article>
