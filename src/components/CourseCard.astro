---
import Icon from './Icon.astro';
import type { Course } from '../data/courses';

export interface Props {
  course: Course;
  compact?: boolean;
}

const { course, compact = false } = Astro.props;
const closed = course.status === 'Coming soon';
---
<article
  class:list={[
    'course-card',
    {
      'course-card--featured': course.featured,
      'course-card--muted': closed,
      'course-card--compact': compact,
      'course-card--with-media': Boolean(course.image),
    },
  ]}
  data-category={course.category}
>
  {course.image && (
    <a href={`/courses/${course.slug}`} class="course-card-media" aria-label={`View ${course.title} programme`}>
      <img
        src={course.image}
        alt={course.title}
        loading="lazy"
        decoding="async"
        class="course-card-img"
      />
      <div class="course-media-overlay">
        <span class="badge course-badge-floating">{course.category}</span>
        <span class:list={['status', 'course-status-floating', { 'status--soon': closed }]}>
          <span class="status-dot"></span>
          {course.status}
        </span>
      </div>
    </a>
  )}

  <div class="course-card-content">
    {!course.image && (
      <div class="course-card-top">
        <span class="badge">{course.category}</span>
        <span class:list={['status', { 'status--soon': closed }]}>
          <span class="status-dot"></span>
          {course.status}
        </span>
      </div>
    )}

    <div class="course-card-title-row">
      <div class="course-card-icon">
        <Icon name={course.icon} size={22} />
      </div>
      <h3><a href={`/courses/${course.slug}`}>{course.title}</a></h3>
    </div>

    <p class="course-card-summary">{course.summary}</p>

    <ul class="course-meta">
      <li><Icon name="clock" size={14} /> {course.duration}</li>
      <li><Icon name="monitor" size={14} /> {course.format}</li>
      <li><Icon name="graduation-cap" size={14} /> {course.level}</li>
    </ul>

    <div class="course-card-footer">
      <a class="text-link" href={`/courses/${course.slug}`}>
        View syllabus
        <Icon name="arrow-right" size={15} />
      </a>
      {closed ? (
        <a class="text-link text-link--quiet" href="/contact">Register interest</a>
      ) : (
        <button type="button" class="btn btn-gold course-card-apply-btn" data-open-admission data-programme={course.slug}>
          Apply now
          <Icon name="arrow-up-right" size={14} />
        </button>
      )}
    </div>
  </div>
</article>
